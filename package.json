{
  "name": "brewhub",
  "productName": "BrewHub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A place to find and share your favorite brews.",
  "author": "Ivan Bottigelli",
  "license": "MIT",
  "main": "electron.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next build && electron-forge start",
    "package": "next build && electron-forge package",
    "make": "next build && electron-forge make",
    "lint": "next lint"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "dotenv": "^16.5.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^36.4.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "public/macos_dev/AppIcon",
        "executableName": "brewhub",
        "files": [
          "electron.js",
          ".next/",
          "public/",
          "node_modules/",
          "package.json"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-dmg",
          "platforms": [
            "darwin"
          ],
          "config": {
            "icon": "public/macos_dev/AppIcon.icns",
            "format": "ULFO"
          }
        },
        {
          "name": "@electron-forge/maker-deb",
          "platforms": [
            "linux"
          ],
          "config": {
            "options": {
              "icon": "public/web_dev/icon-512-maskable.png"
            }
          }
        },
        {
          "name": "@electron-forge/maker-rpm",
          "platforms": [
            "linux"
          ],
          "config": {
            "options": {
              "icon": "public/web_dev/icon-512-maskable.png"
            }
          }
        }
      ]
    }
  }
}

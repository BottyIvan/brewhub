{
  "name": "brewhub",
  "productName": "BrewHub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A place to find and share your favorite brews.",
  "author": "Ivan Bottigelli",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "ELECTRON_START_URL=http://localhost:3000 electron electron.js",
    "electron:prod": "next build && next start & ELECTRON_START_URL=http://localhost:3000 electron electron.js",
    "electron:dist": "next build && electron-builder"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "dotenv": "^16.5.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "cloud.ivanbotty.brewhub",
    "productName": "BrewHub",
    "mac": {
      "icon": "public/macos_dev/AppIcon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/web_dev/favicon.ico"
    },
    "linux": {
      "icon": "public/web_dev/icon-512-maskable.png"
    }
  }
}